def REPO_URL = 'https://github.com/apisit110/pos-center.git'

// service (folder ใน apps/) = ชื่อ image (pos-center/<service>)
def SERVICES = [
    'portal',
    'portal-service',
    'pos-sync-service',
]

pipeline {
    agent any

    parameters {
        // ต้องติดตั้ง Git Parameter plugin
        gitParameter(
            name: 'BRANCH',
            type: 'PT_BRANCH',
            branchFilter: 'origin/(release.*)',
            defaultValue: 'release/1.0.0',
            selectedValue: 'TOP',
            sortMode: 'DESCENDING_SMART',
            listSize: '0', // 0 = แสดงเป็น dropdown
            useRepository: REPO_URL,
            description: 'เลือก release branch ที่จะ build'
        )
        booleanParam(name: 'portal', defaultValue: false)
        booleanParam(name: 'portal-service', defaultValue: false)
        booleanParam(name: 'pos-sync-service', defaultValue: false)
    }

    environment {
        DOCKER_BUILDKIT = '1'
        IMAGE_TAG = "${(params.BRANCH ?: '').replace('release/', '')}"
        // portal deploy เป็น static ไปที่ S3 + CloudFront (ดู terraform/)
        AWS_REGION = 'ap-southeast-1'
        PORTAL_BUCKET = 'lab-pos-cashier-center'
        // terraform output cloudfront_distribution_id (เว้นว่าง = ไม่ invalidate)
        CLOUDFRONT_DISTRIBUTION_ID = ''
    }

    stages {
        stage('Validate') {
            steps {
                script {
                    if (!params.BRANCH) {
                        error 'ไม่ได้เลือก BRANCH'
                    }
                    env.SELECTED = SERVICES.findAll { params[it] }.join(' ')
                    if (!env.SELECTED) {
                        error 'ต้องเลือกอย่างน้อย 1 service'
                    }
                    echo "Branch: ${params.BRANCH}"
                    echo "Services: ${env.SELECTED}"
                }
            }
        }

        stage('Checkout') {
            steps {
                git branch: params.BRANCH, url: REPO_URL
            }
        }

        // portal ไม่ได้เป็น image แต่ export เป็น static แล้วขึ้น S3 + CloudFront
        stage('portal') {
            when { expression { params['portal'] } }
            stages {
                stage('Export Portal') {
                    environment {
                        // @apisit110/pos-ui อยู่บน GitHub Packages ต้องใช้ token ส่งเป็น build secret
                        NODE_AUTH_TOKEN = credentials('github-packages-token')
                    }
                    steps {
                        // Dockerfile.export มี stage สุดท้ายเป็น scratch ที่มีแค่ไฟล์ static -> --output เขียนลง apps/portal/out
                        sh '''
                            rm -rf apps/portal/out
                            docker build -f apps/portal/Dockerfile.export \\
                              --secret id=node_auth_token,env=NODE_AUTH_TOKEN \\
                              --output type=local,dest=apps/portal/out .
                            test -f apps/portal/out/index.html
                        '''
                    }
                }

                stage('Upload to S3') {
                    steps {
                        // aws cli ติดตั้งไว้ใน jenkins/Dockerfile
                        // ต้องติดตั้ง AWS Credentials plugin และสร้าง credential ชนิด AWS ชื่อ aws-credentials
                        withCredentials([[$class: 'AmazonWebServicesCredentialsBinding', credentialsId: 'aws-credentials']]) {
                            sh '''
                                # ไฟล์ใน _next/static มี hash ในชื่อ cache ได้ยาว
                                aws s3 sync apps/portal/out/_next/static "s3://$PORTAL_BUCKET/_next/static" \\
                                  --delete --cache-control "public,max-age=31536000,immutable"
                                
                                # ที่เหลือ (html ฯลฯ) ต้องเช็คใหม่ทุกครั้งให้เห็น release ใหม่ทันที
                                aws s3 sync apps/portal/out "s3://$PORTAL_BUCKET" \\
                                  --delete --exclude "_next/static/*" --cache-control "no-cache"
                                
                                if [ -n "$CLOUDFRONT_DISTRIBUTION_ID" ]; then
                                  aws cloudfront create-invalidation --distribution-id "$CLOUDFRONT_DISTRIBUTION_ID" --paths "/*"
                                fi
                            '''
                        }
                    }
                }
            }
        }

        stage('portal-service') {
            when { expression { params['portal-service'] } }
            steps {
                sh "docker build -f apps/portal-service/Dockerfile -t pos-center/portal-service:${env.IMAGE_TAG} ."
            }
        }

        stage('pos-sync-service') {
            when { expression { params['pos-sync-service'] } }
            steps {
                sh "docker build -f apps/pos-sync-service/Dockerfile -t pos-center/pos-sync-service:${env.IMAGE_TAG} ."
            }
        }
    }
}
